# --- KDEs
g1 = sns.kdeplot(beta_S_clean, fill=False, color=sns.xkcd_rgb['denim blue'], linestyle='-',
                 label=rf'$\beta_S$ = {med_s:.2f} (10–100 yrs, {n_s} records)', ax=ax)
